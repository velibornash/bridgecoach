// Bridge Coach — persistent data layer (Sprint 58).
//
// ARCHITECTURAL RULES (do not violate without reading docs/verification/SPRINT_58_VERIFICATION.md):
//  1. The database stores FACTS AND EVENTS. It never implements bridge rules.
//     Legality / auction state / contract stay in src/bridge (AuctionStateMachine,
//     LegalBidValidator, ContractCalculator). A persisted Auction is replayed through
//     AuctionStateMachine to reconstruct state — the DB is never a second bidding engine.
//  2. Every private, user-owned row has an explicit `userId` owner relation.
//     There is no implicit "the" current user in the schema.
//  3. Progression is derived from XPEvent rows (see 58.3.4), never from a mutable
//     counter that components edit directly.
//
// Bridge calls are persisted as STRUCTURED events (AuctionAction), never as a
// flattened string like "1NT 2C 2H 3NT".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Position {
  N
  E
  S
  W
}

enum Vulnerability {
  None
  NS
  EW
  All
}

enum Strain {
  C
  D
  H
  S
  NT
}

enum BidType {
  bid
  pass
  double
  redouble
}

enum ExperienceLevel {
  new
  beginner
  intermediate
  advanced
}

enum Sex {
  M
  F
  O
}

enum CourseRole {
  author
  editor
}

enum DraftStatus {
  draft
  published
  archived
}

enum BlockType {
  heading
  paragraph
  callout
  example
  hint
  reveal_answer
  quiz
  flashcard
  interactive_board
  divider
  text
  tip
  // Prisma enum values cannot contain "-"; maps to the "card-interactive" block type.
  card_interactive
}

enum MissionType {
  daily
  weekly
  season
  main
  side
  bonus
}

enum MissionCategory {
  daily
  weekly
}

enum AchievementCategory {
  learning
  bidding
  streak
  practice
  quiz
  social
  milestone
}

enum Difficulty {
  Beginner
  Intermediate
  Advanced
}

enum XPEventType {
  LESSON_COMPLETED
  QUIZ_COMPLETED
  PRACTICE_COMPLETED
  ACHIEVEMENT_UNLOCKED
  MISSION_COMPLETED
  DAILY_CHALLENGE_COMPLETED
  BOOKMARK_CREATED
  NOTE_CREATED
  COURSE_COMPLETED
}

enum XPEventStatus {
  pending
  applied
  rejected
}

enum MessageRole {
  user
  assistant
  system
}

// ---------------------------------------------------------------------------
// Identity & profile
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  // Null until Sprint 59 replaces the development identity with real auth.
  passwordHash String?
  firstName String
  lastName  String
  avatar    String   @default("")
  country   String   @default("US")
  sex       Sex?
  experienceLevel ExperienceLevel @default(new)
  // Sprint 60: who may administer the app, and whether this account may sign in
  // at all. A newly registered account is PENDING and cannot create a session;
  // an OWNER approves it from /admin.
  role      UserRole   @default(user)
  status    UserStatus @default(pending)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Progression is DERIVED from XPEvent; these are read-model caches only and are
  // written exclusively by the progression engine.
  xp            Int @default(0)
  level         Int @default(1)
  streak        Int @default(0)
  longestStreak Int @default(0)
  lastActiveAt  DateTime?
  // Marks rows created by prisma/seed.ts so seed data is distinguishable from
  // production-created data (Sprint 58 §18).
  isSeed        Boolean @default(false)

  sessions         Session[]
  authEvents       AuthEvent[]
  resetTokens      PasswordResetToken[]
  profile          Profile?
  lessonProgress   LessonProgress[]
  courseProgress   CourseProgress[]
  practiceSessions PracticeSession[]
  auctions         Auction[]
  hands            Hand[]
  quizAttempts     QuizAttempt[]
  achievements     UserAchievement[]
  missions         UserMission[]
  xpEvents         XPEvent[]
  bookmarks        Bookmark[]
  notes            Note[]
  conversations    AIConversation[]
  authorContents   AuthorContent[]
  authorDrafts     AuthorDraft[]
  registrationDecisions RegistrationRequest[] @relation("RegistrationDecidedBy")
  activity         Activity[]

  @@index([lastActiveAt])
  @@index([isSeed])
  @@index([status])
  @@index([role])
}

enum UserRole {
  owner
  admin
  user
}

enum UserStatus {
  // Registered but not yet approved. Cannot sign in: resolveUserId() refuses a
  // session for a non-active account, so approval is enforced at the same place
  // as authentication rather than only in the UI.
  pending
  active
  rejected
  suspended
}

/// A server-side login session.
///
/// SECURITY
///  - The cookie carries an opaque id whose SHA-256 hash is stored here, so a
///    database leak does not hand out live sessions.
///  - Sessions are revocable server-side. A JWT in a cookie cannot be, which is
///    the reason this is a table and not a self-contained token.
///  - `expiresAt` is enforced on read; expired rows are swept by a helper.
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Security audit trail. Never stores a password or a session token.
model AuthEvent {
  id        String   @id @default(cuid())
  userId    String?
  /// SIGN_IN, SIGN_UP, SIGN_OUT, SIGN_IN_FAILED, PASSWORD_CHANGED
  type      String
  ip        String?
  ok        Boolean  @default(true)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  bio       String   @default("")
  website   String?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Learning content (static, not user-owned)
// ---------------------------------------------------------------------------

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  position    Int      @default(0)
  published   Boolean  @default(true)
  isSeed      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  episodes Episode[]
  lessons  Lesson[]

  @@index([position])
}

model Episode {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  description String @default("")
  position  Int      @default(0)
  isSeed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, position])
}

model Lesson {
  id          String   @id
  courseId    String?
  episodeId   String?
  title       String
  description String   @default("")
  category    String   @default("")
  subcategory String   @default("")
  duration    String   @default("")
  xpReward    Int      @default(50)
  position    Int      @default(0)
  content     Json?
  isSeed      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course        Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  episode       Episode?         @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  progress      LessonProgress[]
  bookmarks     Bookmark[]
  notes         Note[]

  @@index([courseId, position])
  @@index([episodeId, position])
}

model LessonProgress {
  id                   String    @id @default(cuid())
  userId               String
  lessonId             String
  completed            Boolean   @default(false)
  completedSectionIds  String[]  @default([])
  currentSectionIndex  Int       @default(0)
  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  lastViewedAt         DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // One progress row per (user, lesson) — enforces "no duplicate progress".
  @@unique([userId, lessonId])
  @@index([userId, completed])
  @@index([lessonId])
}

model CourseProgress {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  completed   Boolean   @default(false)
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Bridge content: hands, auctions, practice
// ---------------------------------------------------------------------------

model Hand {
  id            String   @id @default(cuid())
  userId        String?
  label         String?
  dealer        Position
  vulnerability Vulnerability @default(None)
  // Suit arrays keyed by spades/hearts/diamonds/clubs, engine notation ("SA").
  north         Json
  east          Json
  south         Json
  west          Json
  isSeed        Boolean  @default(false)
  createdAt     DateTime @default(now())

  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  auctions  Auction[]
  sessions  PracticeSession[]

  @@index([userId, createdAt])
}

model Auction {
  id            String       @id @default(cuid())
  userId        String
  handId        String?
  dealer        Position
  vulnerability Vulnerability @default(None)
  // Final contract once the auction closes; null while open.
  finalLevel    Int?
  finalStrain   Strain?
  finalDoubled  Boolean?
  finalRedoubled Boolean?
  declarer      Position?
  passedOut     Boolean       @default(false)
  isComplete    Boolean       @default(false)
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  createdAt     DateTime      @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  hand     Hand?          @relation(fields: [handId], references: [id], onDelete: SetNull)
  actions  AuctionAction[]
  sessions PracticeSession[]

  @@index([userId, startedAt])
  @@index([handId])
  @@index([userId, isComplete])
}

model AuctionAction {
  id        String   @id @default(cuid())
  auctionId String
  // Position that made the call, in engine terms.
  player    Position
  type      BidType
  level     Int?
  strain    Strain?
  // Engine verdict snapshot (facts, not a second rules engine).
  engineLegal Boolean
  engineReason String?
  // Deterministic strategy recommendation at the time of the call, if any.
  suggestedBid String?
  strategyRuleName String?
  // Free-form context (e.g. the player's hand for this seat).
  context    Json?
  sequence   Int
  createdAt  DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  // "No duplicate auction actions" — a position cannot appear twice at a sequence.
  @@unique([auctionId, sequence])
  @@index([auctionId, sequence])
}

model PracticeSession {
  id           String    @id @default(cuid())
  userId       String
  handId       String?
  auctionId    String?
  scenario     String?
  difficulty   Difficulty @default(Beginner)
  context      String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  durationMs   Int?
  score        Int?
  maxScore     Int?
  isComplete   Boolean   @default(false)
  // Engine-derived outcome; the DB records it, it does not compute it.
  finalContract String?
  declarer      Position?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  hand    Hand?            @relation(fields: [handId], references: [id], onDelete: SetNull)
  auction Auction?         @relation(fields: [auctionId], references: [id], onDelete: SetNull)
  actions PracticeAction[]

  @@index([userId, startedAt])
  @@index([userId, isComplete])
  @@index([handId])
}

model PracticeAction {
  id        String   @id @default(cuid())
  sessionId String
  phase     String
  sequence  Int
  player    Position?
  call      String?
  card      String?
  isCorrect Boolean?
  engineFeedback String?
  createdAt DateTime @default(now())

  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([sessionId, phase, sequence])
}

// ---------------------------------------------------------------------------
// Quizzes
// ---------------------------------------------------------------------------

model Quiz {
  id          String   @id
  title       String
  description String   @default("")
  category    String   @default("")
  isSeed      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([category])
}

model QuizQuestion {
  id             String   @id
  quizId         String
  type           String
  question       String
  options        Json
  correctIndex   Int?
  correctIndices Int[]
  correctCards   String[] @default([])
  explanation    String   @default("")
  xpReward       Int      @default(20)
  position       Int      @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, position])
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  quizId         String
  score          Int
  correctAnswers Int
  totalQuestions Int
  xpEarned       Int      @default(0)
  // Per-question answers, keyed by question id.
  answers        Json
  completedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@index([quizId])
}

// ---------------------------------------------------------------------------
// Gamification
// ---------------------------------------------------------------------------

model Achievement {
  id          String              @id
  title       String
  description String              @default("")
  icon        String              @default("trophy")
  category    AchievementCategory @default(milestone)
  xpReward    Int                 @default(50)
  rarity      String              @default("common")
  // Metric the achievement tracks: "lessonsCompleted" | "streak" | "xp" | ...
  metric      String
  threshold   Int
  isSeed      Boolean             @default(false)
  createdAt   DateTime            @default(now())

  users UserAchievement[]

  @@index([category])
}

model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  progress      Int       @default(0)
  unlocked      Boolean   @default(false)
  unlockedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  // "No duplicate achievements" — enforced by the database, not by application code.
  @@unique([userId, achievementId])
  @@index([userId, unlocked])
}

model Mission {
  id          String          @id
  title       String
  description String          @default("")
  type        MissionType
  category    MissionCategory
  metric      String
  target      Int
  xpReward    Int              @default(50)
  icon        String           @default("target")
  active      Boolean          @default(true)
  isSeed      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  users UserMission[]

  @@index([active])
}

model UserMission {
  id        String    @id @default(cuid())
  userId    String
  missionId String
  progress  Int       @default(0)
  completed Boolean   @default(false)
  completedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@index([userId, completed])
}

model XPEvent {
  id         String        @id @default(cuid())
  userId     String
  type       XPEventType
  // Deduplication key: e.g. "lesson:l1" or "quiz-attempt:<uuid>".
  reference  String
  amount     Int
  status     XPEventStatus @default(pending)
  // Arbitrary provenance so a progression value can always be explained.
  metadata   Json?
  createdAt  DateTime      @default(now())
  appliedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "No duplicate XP events" — the database rejects a second award for the
  // same logical achievement.
  @@unique([userId, type, reference])
  @@index([userId, createdAt])
  @@index([userId, status])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String
  refId     String?
  title     String
  xp        Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// User content
// ---------------------------------------------------------------------------

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  lessonId   String?
  type       String   @default("lesson")
  refId      String?
  title      String
  description String  @default("")
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@index([lessonId])
}

model Note {
  id         String   @id @default(cuid())
  userId     String
  lessonId   String?
  title      String
  content    String
  tags       String[] @default([])
  // Pinning is an existing product feature (Sprint 58 §14 preserves it), so it
  // is persisted rather than kept in component state.
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([lessonId])
}

// ---------------------------------------------------------------------------
// AI conversations
// ---------------------------------------------------------------------------

model AIConversation {
  id         String   @id @default(cuid())
  userId     String
  title      String   @default("New conversation")
  // Reference to the domain entity the conversation is about, instead of
  // duplicating the hand/auction into every message (Sprint 58 §17).
  practiceSessionId String?
  handId     String?
  auctionId  String?
  context    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt])
  @@index([practiceSessionId])
  @@index([handId])
  @@index([auctionId])
}

model AIMessage {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  // Provider metadata. Never store API keys or credentials.
  provider       String?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  estimated      Boolean?
  createdAt      DateTime    @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Author Studio
// ---------------------------------------------------------------------------

model AuthorContent {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String     @default("")
  status      DraftStatus @default(draft)
  role        CourseRole @default(author)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  drafts    AuthorDraft[]
  revisions AuthorRevision[]

  @@index([userId, status])
  @@index([status, publishedAt])
}

model AuthorDraft {
  id         String   @id @default(cuid())
  userId     String
  contentId  String?
  title      String
  blocks     Json
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  content AuthorContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([contentId])
}

model AuthorRevision {
  id         String   @id @default(cuid())
  contentId  String
  title      String
  blocks     Json
  version    Int
  note       String?
  createdAt  DateTime @default(now())

  content AuthorContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, version])
  @@index([contentId, version])
}

/// A single-use password reset token (Sprint 60).
///
/// Only the SHA-256 hash is stored, same reasoning as sessions: a database leak
/// must not hand out working reset links. `usedAt` makes a token single-use, so
/// replaying an old email cannot change a password twice.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Outgoing email, kept so the flow is verifiable without a paid provider.
///
/// In development every message is recorded here and the admin page can read it,
/// which means the password reset flow can be completed end to end offline. With
/// RESEND_API_KEY set, a real message is sent through Resend's free tier and the
/// row is retained as a delivery record.
///
/// The body is stored because in development it is the only place the reset link
/// exists. `to` is always present, which is why this table must never be exposed
/// to a non-administrator.
model OutgoingEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  provider  String
  status    String   @default("queued")
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A registration request awaiting an administrator's decision.
model RegistrationRequest {
  id        String    @id @default(cuid())
  email     String    @unique
  firstName String
  lastName  String
  country   String    @default("US")
  experienceLevel ExperienceLevel @default(new)
  status    String    @default("pending")
  note      String?
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  decidedByUser User? @relation("RegistrationDecidedBy", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}
