# Copy to .env and fill in your keys. Never commit .env.
# At least one provider is required for real AI coach answers and hints;
# without any, the app falls back to the built-in offline coach.

# Which provider to use: "opencode" | "openai" | "anthropic" | "ollama"
# If unset, the first configured key wins: opencode > openai > anthropic.
AI_PROVIDER=opencode

# --- Database (PostgreSQL) ---
# Sprint 58. Used by Prisma. Never commit .env.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# The password must be URL-encoded if it contains special characters.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bridgecoach?schema=public"

# --- AI provider (see below) ---
# --- OpenCode (managed, default) ---
# Primary: Go endpoint (Anthropic-style /v1/messages).
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=qwen3.7-plus
# Fallback: Zen endpoint (OpenAI-style /chat/completions), primary then fallback model.
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=big-pickle
OPENCODE_ZEN_FALLBACK_MODEL=mimo-v2.5-free

# --- OpenAI / OpenAI-compatible ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Ollama (local, no key required) ---
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# --- Gateway tuning (optional) ---
# AI_MAX_RETRIES=2
# AI_RETRY_BACKOFF_MS=1500

# --- SEO (optional) ---
# Canonical site URL for sitemap/robots/OG metadata.
# NEXT_PUBLIC_SITE_URL=https://bridgecoach.vercel.app
# Google Search Console site verification token (added to <head> as google-site-verification).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_token_here

# --- Authentication (Sprint 59) ---
# Signs the session cookie. Generate with: openssl rand -base64 32
# REQUIRED in production; the app refuses to start without it.
SESSION_SECRET=

# Password for the seeded development identity. Never commit it.
# Leave empty and the dev account cannot sign in (local work still works
# through the development identity fallback).
DEV_USER_PASSWORD=

# Escape hatch that lets private data resolve to DEV_USER_EMAIL without a
# session. Honoured ONLY when NODE_ENV is not production — in production the
# app refuses to resolve the development identity at all.
# Set to "true" for local development without signing in on every request.
ALLOW_DEV_IDENTITY=true

# bcrypt cost factor (10-15). 12 is the OWASP-aligned default.
BCRYPT_COST=12
