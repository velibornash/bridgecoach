# Copy to .env and fill in your keys. Never commit .env.
# At least one provider is required for real AI coach answers and hints;
# without any, the app falls back to the built-in offline coach.

# Which provider to use: "openai" | "anthropic" | "ollama"
# If unset, the first configured key below wins (openai > anthropic).
# AI_PROVIDER=ollama

# --- OpenAI / OpenAI-compatible ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Ollama (local, no key required) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# --- Gateway tuning (optional) ---
# AI_MAX_RETRIES=2
# AI_RETRY_BACKOFF_MS=1500
